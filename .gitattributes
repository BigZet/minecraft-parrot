* text=auto eol=lf

# gradlew — шелл-скрипт: CRLF ломает его на Linux/macOS и в CI.
gradlew text eol=lf
*.sh text eol=lf

# Батники должны оставаться с CRLF.
*.bat text eol=crlf

*.jar binary
*.png binary

# Установщик для Windows: cmd и инструкция для стримера с CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
installer/*.txt text eol=crlf
